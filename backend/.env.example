PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Claude) ---
ANTHROPIC_API_KEY=

# --- Email (Resend) — required for signup/login OTP + passphrase-reset emails ---
RESEND_API_KEY=
RESEND_FROM=

# --- Onairos — callback / token verification ---
ONAIROS_API_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_GIFT_PRICE_ID=

# --- Crypto ---
# 64 hex chars (32 bytes) for AES-256-GCM. Generate: `openssl rand -hex 32`
# MUST stay identical across restarts/instances forever — rotating it makes all
# previously-encrypted data (reflections, polaris messages) unreadable.
ENCRYPTION_KEY=

# --- Prisma — Supabase Postgres connection (see prisma/schema.prisma) ---
# Transaction-mode pooler (:6543, pgbouncer=true) for app runtime queries.
DATABASE_URL=
# Session-mode pooler (:5432) for migrations / introspection (prisma db pull).
DIRECT_URL=
